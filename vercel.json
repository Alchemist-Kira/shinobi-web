{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/proxy/(.*)", "destination": "/api/proxy.js" },
    { "source": "/api/sources", "destination": "/api/sources.js" },
    { "source": "/api/sources/:path*", "destination": "/api/sources.js?route=:path*" },
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
